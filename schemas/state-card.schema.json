{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Duolingo state card v5 with separate curriculum progress, grammar mastery, and prerequisite review",
  "type": "object",
  "required": [
    "card_version",
    "course_key",
    "course_id",
    "updated_at",
    "current_position",
    "active_block",
    "mastery",
    "review_queue",
    "recurring_error_patterns",
    "next_action",
    "last_session_note"
  ],
  "properties": {
    "card_version": {
      "const": 5
    },
    "course_key": {
      "enum": [
        "es-hu",
        "en-hu"
      ]
    },
    "course_id": {
      "type": "string"
    },
    "updated_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "current_position": {
      "type": "object",
      "required": [
        "section",
        "unit",
        "unit_title",
        "source",
        "confirmed_at"
      ],
      "properties": {
        "section": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "unit": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "unit_title": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 120
        },
        "source": {
          "enum": [
            "learner_report",
            "screenshot",
            "not_confirmed"
          ]
        },
        "confirmed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "coordinate_system": {
          "enum": [
            "section_unit",
            "module_unit"
          ]
        },
        "module": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "course_unit": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "active_block": {
      "type": "object",
      "required": [
        "module_id",
        "status",
        "current_subtopic",
        "completed_subtopics",
        "next_subtopic",
        "check_stage",
        "transfer_task",
        "transfer_status",
        "error_diagnosis",
        "choice_task",
        "prerequisite_review"
      ],
      "properties": {
        "module_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(A1|A2|B1|B2)-[0-9]{2}$"
        },
        "status": {
          "enum": [
            "not_started",
            "in_progress",
            "checkpoint_ready",
            "completed"
          ]
        },
        "current_subtopic": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 100
        },
        "completed_subtopics": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 100
          },
          "maxItems": 12
        },
        "next_subtopic": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 100
        },
        "check_stage": {
          "enum": [
            "not_started",
            "recognition",
            "reasoning",
            "guided_application",
            "transfer",
            "completed"
          ]
        },
        "transfer_task": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 180
        },
        "transfer_status": {
          "enum": [
            "not_asked",
            "pending",
            "passed",
            "retry"
          ]
        },
        "error_diagnosis": {
          "type": "object",
          "required": [
            "pattern_id",
            "hypothesis",
            "observed_once",
            "last_example",
            "stage"
          ],
          "properties": {
            "pattern_id": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 60
            },
            "hypothesis": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 160
            },
            "observed_once": {
              "type": "boolean"
            },
            "last_example": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 120
            },
            "stage": {
              "enum": [
                "none",
                "candidate",
                "diagnosing",
                "targeted_reteach",
                "verification"
              ]
            }
          },
          "additionalProperties": false
        },
        "choice_task": {
          "type": "object",
          "required": [
            "task_id",
            "stage",
            "question",
            "options",
            "status",
            "selected_option"
          ],
          "properties": {
            "task_id": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 48
            },
            "stage": {
              "enum": [
                "none",
                "recognition",
                "reasoning",
                "guided_application",
                "transfer",
                "diagnosis"
              ]
            },
            "question": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 280
            },
            "options": {
              "type": "array",
              "maxItems": 4,
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "text"
                ],
                "properties": {
                  "id": {
                    "enum": [
                      "A",
                      "B",
                      "C",
                      "D"
                    ]
                  },
                  "text": {
                    "type": "string",
                    "maxLength": 180
                  }
                },
                "additionalProperties": false
              }
            },
            "status": {
              "enum": [
                "not_asked",
                "pending",
                "answered",
                "paused"
              ]
            },
            "selected_option": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "A",
                "B",
                "C",
                "D",
                null
              ]
            },
            "mode": {
              "enum": [
                "single",
                "batch"
              ]
            },
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 5,
              "items": {
                "type": "object",
                "required": [
                  "item_id",
                  "question",
                  "options",
                  "selected_option"
                ],
                "properties": {
                  "item_id": {
                    "type": "string",
                    "maxLength": 48
                  },
                  "question": {
                    "type": "string",
                    "maxLength": 280
                  },
                  "options": {
                    "type": "array",
                    "maxItems": 4,
                    "items": {
                      "type": "object",
                      "required": [
                        "id",
                        "text"
                      ],
                      "properties": {
                        "id": {
                          "enum": [
                            "A",
                            "B",
                            "C",
                            "D"
                          ]
                        },
                        "text": {
                          "type": "string",
                          "maxLength": 180
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "selected_option": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "enum": [
                      "A",
                      "B",
                      "C",
                      "D",
                      null
                    ]
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "prerequisite_review": {
          "type": "object",
          "required": [
            "status",
            "module_id",
            "concept",
            "reason",
            "return_to_module_id",
            "return_to_subtopic"
          ],
          "properties": {
            "status": {
              "enum": [
                "none",
                "pending",
                "in_progress",
                "verified"
              ]
            },
            "module_id": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^(A1|A2|B1|B2)-[0-9]{2}$"
            },
            "concept": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 100
            },
            "reason": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 140
            },
            "return_to_module_id": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^(A1|A2|B1|B2)-[0-9]{2}$"
            },
            "return_to_subtopic": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 100
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "mastery": {
      "type": "array",
      "maxItems": 18,
      "items": {
        "type": "object",
        "required": [
          "module_id",
          "concept",
          "status",
          "evidence",
          "last_checked",
          "evidence_basis"
        ],
        "properties": {
          "module_id": {
            "type": "string",
            "pattern": "^(A1|A2|B1|B2)-[0-9]{2}$"
          },
          "concept": {
            "type": "string",
            "maxLength": 100
          },
          "status": {
            "enum": [
              "introduced",
              "understood",
              "stable",
              "needs_review"
            ]
          },
          "evidence": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 140
          },
          "last_checked": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "evidence_basis": {
            "enum": [
              "lesson_explained",
              "choice_check",
              "transfer_check",
              "independent_use",
              "review_triggered",
              "insufficient",
              "legacy_unclassified"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "review_queue": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": [
          "module_id",
          "concept",
          "reason",
          "priority"
        ],
        "properties": {
          "module_id": {
            "type": "string",
            "pattern": "^(A1|A2|B1|B2)-[0-9]{2}$"
          },
          "concept": {
            "type": "string",
            "maxLength": 100
          },
          "reason": {
            "type": "string",
            "maxLength": 140
          },
          "priority": {
            "enum": [
              "low",
              "normal",
              "high"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "recurring_error_patterns": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "pattern_id",
          "label",
          "targeted_rule",
          "evidence_summary",
          "occurrences",
          "status",
          "last_seen"
        ],
        "properties": {
          "pattern_id": {
            "type": "string",
            "maxLength": 60
          },
          "label": {
            "type": "string",
            "maxLength": 80
          },
          "targeted_rule": {
            "type": "string",
            "maxLength": 140
          },
          "evidence_summary": {
            "type": "string",
            "maxLength": 120
          },
          "occurrences": {
            "type": "integer",
            "minimum": 2,
            "maximum": 99
          },
          "status": {
            "enum": [
              "active",
              "improving",
              "resolved"
            ]
          },
          "last_seen": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          }
        },
        "additionalProperties": false
      }
    },
    "next_action": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 160
    },
    "last_session_note": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 240
    }
  },
  "additionalProperties": false
}
