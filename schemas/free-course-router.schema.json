{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Compact Free ChatGPT course router (v1/v2)",
  "type": "object",
  "required": [
    "version",
    "course",
    "language",
    "base",
    "source",
    "sections",
    "modules",
    "route_rule"
  ],
  "properties": {
    "version": {
      "enum": [
        1,
        2
      ]
    },
    "course": {
      "enum": [
        "es-hu",
        "en-hu"
      ]
    },
    "language": {
      "type": "string"
    },
    "base": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "required": [
        "kind",
        "url",
        "checked",
        "limitation"
      ],
      "properties": {
        "kind": {
          "const": "community_public_course_map"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "checked": {
          "type": [
            "string",
            "null"
          ]
        },
        "limitation": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 3,
        "maxItems": 3
      }
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "pre",
          "evidence",
          "bank",
          "lines"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(A1|A2|B1|B2)-[0-9]{2}$"
          },
          "title": {
            "type": "string"
          },
          "pre": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence": {
            "enum": [
              "explicit",
              "observed",
              "inferred",
              "reference_only",
              "unknown"
            ]
          },
          "bank": {
            "enum": [
              "a1",
              "a2",
              "b1",
              "b2"
            ]
          },
          "lines": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "additionalProperties": false
      }
    },
    "route_rule": {
      "type": "string"
    },
    "unit_anchors": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "prefixItems": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ],
            "items": false
          },
          {
            "type": "object",
            "required": [
              "course_unit",
              "section",
              "section_unit",
              "title_hu",
              "guidebook_path",
              "phrase_set_ref",
              "grammar_modules",
              "grammar_topics",
              "evidence"
            ],
            "properties": {
              "course_unit": {
                "type": "integer",
                "minimum": 1
              },
              "section": {
                "type": "integer",
                "minimum": 1
              },
              "section_unit": {
                "type": "integer",
                "minimum": 1
              },
              "title_hu": {
                "type": "string"
              },
              "guidebook_path": {
                "type": "string"
              },
              "phrase_set_ref": {
                "type": "string"
              },
              "grammar_modules": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^(A1|A2|B1|B2)-[0-9]{2}$"
                }
              },
              "grammar_topics": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "evidence": {
                "enum": [
                  "observed_example",
                  "explicit_guidebook_heading",
                  "explicit_grammar_goal",
                  "unknown"
                ]
              },
              "phrase_group_status": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "course_unit_ranges",
              "phrase_set_ref",
              "title_hu",
              "grammar_modules",
              "grammar_topics",
              "evidence"
            ],
            "properties": {
              "course_unit_ranges": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "prefixItems": [
                    {
                      "type": "integer",
                      "minimum": 1
                    },
                    {
                      "type": "integer",
                      "minimum": 1
                    }
                  ],
                  "items": false
                }
              },
              "phrase_set_ref": {
                "type": "string"
              },
              "title_hu": {
                "type": "string"
              },
              "grammar_modules": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^(A1|A2|B1|B2)-[0-9]{2}$"
                }
              },
              "grammar_topics": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "evidence": {
                "enum": [
                  "observed_example",
                  "explicit_guidebook_heading",
                  "explicit_grammar_goal",
                  "unknown"
                ]
              }
            },
            "additionalProperties": false
          },
          {
            "type": "array",
            "minItems": 5,
            "maxItems": 5,
            "prefixItems": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ],
            "items": false
          }
        ]
      }
    },
    "unit_anchor_note": {
      "type": "string"
    },
    "section_themes": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 3,
        "maxItems": 3
      }
    },
    "one_unit_theme": {
      "type": [
        "array",
        "null"
      ]
    },
    "section_theme_note": {
      "type": "string"
    },
    "guidebook_coverage": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "section",
              "course_unit_range",
              "local_unit_range",
              "path",
              "status",
              "phrase_set_count"
            ],
            "properties": {
              "section": {
                "type": "integer",
                "minimum": 1
              },
              "course_unit_range": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "prefixItems": [
                  {
                    "type": "integer",
                    "minimum": 1
                  },
                  {
                    "type": "integer",
                    "minimum": 1
                  }
                ],
                "items": false
              },
              "local_unit_range": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "prefixItems": [
                  {
                    "type": "integer",
                    "minimum": 1
                  },
                  {
                    "type": "integer",
                    "minimum": 1
                  }
                ],
                "items": false
              },
              "path": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "complete",
                  "partial",
                  "in_progress",
                  "unknown"
                ]
              },
              "phrase_set_count": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "module",
              "course_unit_range",
              "local_unit_range",
              "path",
              "status",
              "unit_count",
              "structure"
            ],
            "properties": {
              "module": {
                "type": "integer",
                "minimum": 1
              },
              "course_unit_range": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "prefixItems": [
                  {
                    "type": "integer",
                    "minimum": 1
                  },
                  {
                    "type": "integer",
                    "minimum": 1
                  }
                ],
                "items": false
              },
              "local_unit_range": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "prefixItems": [
                  {
                    "type": "integer",
                    "minimum": 1
                  },
                  {
                    "type": "integer",
                    "minimum": 1
                  }
                ],
                "items": false
              },
              "path": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "complete",
                  "partial",
                  "in_progress",
                  "unknown"
                ]
              },
              "unit_count": {
                "type": "integer",
                "minimum": 0
              },
              "structure": {
                "enum": [
                  "per_unit_examples",
                  "deduplicated_phrase_sets"
                ]
              },
              "phrase_set_count": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "course_completion": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "status",
            "section_count",
            "total_units",
            "last_course_unit",
            "guidebook_coverage",
            "note"
          ],
          "properties": {
            "status": {
              "enum": [
                "complete",
                "partial",
                "in_progress",
                "unknown"
              ]
            },
            "section_count": {
              "type": "integer",
              "minimum": 1
            },
            "total_units": {
              "type": "integer",
              "minimum": 1
            },
            "last_course_unit": {
              "type": "integer",
              "minimum": 1
            },
            "guidebook_coverage": {
              "type": "string"
            },
            "note": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "status",
            "module_count",
            "total_units",
            "last_course_unit",
            "guidebook_coverage",
            "note"
          ],
          "properties": {
            "status": {
              "enum": [
                "complete",
                "partial",
                "in_progress",
                "unknown"
              ]
            },
            "module_count": {
              "type": "integer",
              "minimum": 1
            },
            "total_units": {
              "type": "integer",
              "minimum": 1
            },
            "last_course_unit": {
              "type": "integer",
              "minimum": 1
            },
            "guidebook_coverage": {
              "type": "string"
            },
            "note": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "purpose": {
      "type": "string"
    },
    "starting_point": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "section",
            "unit",
            "course_unit"
          ],
          "properties": {
            "section": {
              "type": "integer",
              "minimum": 1
            },
            "unit": {
              "type": "integer",
              "minimum": 1
            },
            "course_unit": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "module",
            "unit",
            "course_unit"
          ],
          "properties": {
            "module": {
              "type": "integer",
              "minimum": 1
            },
            "unit": {
              "type": "integer",
              "minimum": 1
            },
            "course_unit": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "additionalProperties": false
}
