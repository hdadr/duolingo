  "special_contrasts": [
    {
      "topic": "ser-estar-hay",
      "principle_hu": "ser: azonosítás és besorolás; estar: hely és állapot; hay: létezés/jelenlét."
    },
    {
      "topic": "perfecto-indefinido-imperfecto",
      "principle_hu": "perfecto: jelenhez kapcsolódó időkeret; indefinido: lezárt esemény; imperfecto: háttér, szokás, leírás."
    },
    {
      "topic": "indicativo-subjuntivo",
      "principle_hu": "A módválasztást a főmondat jelentése, bizonyossága, a beszélő hozzáállása és a mellékmondat referense határozza meg; nem egyszerű tény/nem tény szabály."
    },
    {
      "topic": "gustar",
      "principle_hu": "A tetsző dolog a nyelvtani alany; a személy részes esetű névmással jelenik meg, az ige a tetsző dolog számához igazodik."
    },
    {
      "topic": "object_pronouns",
      "principle_hu": "A közvetlen és közvetett tárgy különül el; le/les a lo/la/los/las előtt se alakra vált, ez nem azonos a visszaható se-vel."
    },
    {
      "topic": "por-para",
      "principle_hu": "A para gyakran célt, címzettet, határidőt vagy rendeltetést jelöl; a por gyakran okot, cserét, útvonalat, időtartamot vagy eszközt. A pontos választás mindig a szerkezet jelentésétől függ."
    }
  ],
