  "hungarian_transfer_focus": [
    {
      "topic": "to_be",
      "priority": "high",
      "explanation_hu": "A magyar jelen idejű harmadik személyű névszói állítmányból hiányozhat a létige, az angolban viszont szükséges az am/is/are."
    },
    {
      "topic": "do_support",
      "priority": "high",
      "explanation_hu": "Az angol egyszerű jelen/múlt kérdései és tagadásai do/does/did segédigét használnak; a magyar szórendi kérdésképzés nem helyettesíti ezt."
    },
    {
      "topic": "articles",
      "priority": "very_high",
      "explanation_hu": "A magyar és angol névelők használata nem fedi egymást; különösen fontos a zero article általános jelentése megszámlálhatatlan és többes számú főnevekkel."
    },
    {
      "topic": "word_order",
      "priority": "high",
      "explanation_hu": "Az angol kötöttebb SVO szórendű és rendszerint kifejezett alanyt igényel; a magyar rugalmasabb információs szerkezete nem vihető át szó szerint."
    },
    {
      "topic": "tense_aspect",
      "priority": "very_high",
      "explanation_hu": "A magyar egyetlen múlt idejű fő alakja több angol nézőpontnak felelhet meg; különösen a Present Perfect és a folyamatos alakok igényelnek kontrasztív magyarázatot."
    },
    {
      "topic": "prepositions",
      "priority": "high",
      "explanation_hu": "A magyar esetragok és az angol elöljárószavak nem feleltethetők meg mindig egy az egyben; az in/on/at és az igei vonzatok külön gyakorlást igényelnek."
    },
    {
      "topic": "countability",
      "priority": "high",
      "explanation_hu": "A megszámlálhatóság befolyásolja a névelőket és a mennyiségjelölőket: much/many, few/little, some/any."
    },
    {
      "topic": "verb_patterns",
